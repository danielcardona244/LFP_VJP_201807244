<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Transpilador USAC</title>
    <link rel="stylesheet" href="/css/index.css">
</head>
<body>
    <header>
        <h1>Transpilador USAC</h1>
        <nav>
            <div class="dropdown">
                <button class="dropbtn">Archivo</button>
                <div class="dropdown-content">
                    <button onclick="clearAll()">Limpiar Editor</button>
                    <label for="fileInput">Cargar Archivo</label>
                    <input type="file" id="fileInput" accept=".cs" onchange="loadFile()" hidden>
                </div>
            </div>
            <a href="#" onclick="showReport('tokens')">Token Report</a>
            <a href="#" onclick="showReport('lexicalErrors')">Error Léxico</a>
            <a href="#" onclick="showReport('syntaxErrors')">Error Sintáctico</a>
            <a href="#" onclick="showReport('symbols')">Tabla de Símbolos</a>
        </nav>
    </header>

    <main>
        <section class="editor-section">
            <div class="editor">
                <h2>Editor de Texto en C#</h2>
                <textarea id="editor" placeholder="using System;..."></textarea>
            </div>

            <div class="translator">
                <h2>Salida Traducida a TypeScript</h2>
                <textarea id="tsOutput" readonly></textarea>
            </div>
        </section>

        <div class="center-btn">
            <button onclick="analyze()">Analizar</button>
        </div>

        <section class="output-section">
            <div class="console">
                <h2>Salida de Consola</h2>
                <textarea id="consoleOutput" readonly></textarea>
            </div>

            <div class="report">
                <h2>Reportes</h2>
                <div id="report">
                    <i>No hay datos</i>
                </div>
            </div>
        </section>
    </main>

    <script src="/js/index.js"></script>
</body>
</html>
