<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Práctica Análisis Léxico - Equipos Pokémon</title>
    <link rel="stylesheet" href="/css/index.css">
</head>
<body>
    <div class="container">
        <h1>Analizador Léxico de Equipos Pokémon</h1>
        <div class="toolbar" style="justify-content: space-between;">
    <div style="display: flex; gap: 10px;">
        <!-- Combobox Archivo -->
<div class="dropdown" style="position: relative;">
    <button class="toolbar" style="background: #43a047; color: #fff; min-width: 120px;">Archivo &#9662;</button>
    <div class="dropdown-content" style="display: none; position: absolute; left: 0; top: 110%; background: #fff; min-width: 160px; box-shadow: 0 2px 8px #0002; border-radius: 6px; z-index: 10;">
        <label for="fileInput" style="display: block; padding: 10px 18px; cursor: pointer; color: #125ea7; font-weight: bold;">Subir Archivo</label>
        <input type="file" id="fileInput" accept=".pklfp" onchange="cargarArchivo()" style="display:none;">
        <button onclick="guardarArchivo()" style="display: block; width: 100%; padding: 10px 18px; border: none; background: none; text-align: left; cursor: pointer; color: #1976d2;">Guardar Archivo</button>
        <button onclick="limpiarEditor()" style="display: block; width: 100%; padding: 10px 18px; border: none; background: none; text-align: left; cursor: pointer; color: #1976d2;">Limpiar Editor</button>
    </div>
</div>
    </div>
    <div style="display: flex; gap: 10px;">
        <button class="btn-azul" onclick="mostrarManual('tecnico')">Manual Técnico</button>
        <button class="btn-azul" onclick="mostrarManual('usuario')">Manual de Usuario</button>
    </div>
</div>
        <div id="editor" class="editor" contenteditable="true" spellcheck="false"></div>
        <div class="actionbar" style="justify-content: flex-end; margin: 15px 0 20px 0;">
            <button onclick="analizar()">Analizar</button>
            <button onclick="verEquipos()">Ver equipos</button>
        </div>

        <h2>Tokens reconocidos</h2>
        <table id="tablaTokens">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fila</th>
                    <th>Columna</th>
                    <th>Lexema</th>
                    <th>Token</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <h2>Errores léxicos</h2>
        <table id="tablaErrores" class="error-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fila</th>
                    <th>Columna</th>
                    <th>Carácter</th>
                    <th>Descripción</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <div id="aviso" style="display:none; position:fixed; top:30px; left:50%; transform:translateX(-50%); background:#1976d2; color:#fff; padding:16px 32px; border-radius:8px; font-size:1.1em; box-shadow:0 2px 8px #0003; z-index:1000; transition:opacity 0.3s;"></div>
    </div>
    <script src="/js/index.js"></script>
    <script>
function mostrarManual(tipo) {
    if (tipo === 'tecnico') {
        window.open('/manuales/Manual Técnico.pdf', '_blank');
    } else {
        window.open('/manuales/Manual de Usuario.pdf', '_blank');
    }
}
// Dropdown Archivo
document.addEventListener('DOMContentLoaded', function() {
    const dropdown = document.querySelector('.dropdown');
    const btn = dropdown.querySelector('button');
    const content = dropdown.querySelector('.dropdown-content');
    btn.onclick = function(e) {
        e.stopPropagation();
        content.style.display = content.style.display === 'block' ? 'none' : 'block';
    };
    document.body.onclick = function() {
        content.style.display = 'none';
    };
});
</script>
</body>
</html>